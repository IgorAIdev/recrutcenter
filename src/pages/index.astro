---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PayBlock from '../components/PayBlock.astro';
import PathTiles from '../components/PathTiles.astro';
import WhyBlock from '../components/WhyBlock.astro';
import VacancyCard from '../components/VacancyCard.astro';
import { vacancies, lastUpdatedAt } from '../data/taxonomy';
import { positions, shortDate } from '../lib/format';

// Порядок блоків — це порядок питань у голові кандидата (розділ 3 брифу).
const CARD_LIMIT = 9;

// Свіжі згори: блок має доводити, що дані живі.
const sorted = [...vacancies].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
const total = vacancies.length;

const title = 'Вакансії ЗСУ за спеціальністю, регіоном і сумою — Центр рекрутингу';
const description =
  'Відкриті посади у підрозділах Збройних Сил України: спеціальність, підрозділ, регіон служби та сума виплати в кожній вакансії. Заявка — дві хвилини, відповідь рекрутера — до 24 годин.';

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOrganization',
  name: 'Центр рекрутингу Збройних Сил України',
  url: Astro.site?.href,
  areaServed: 'UA',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'recruitment',
      telephone: '+380800000000',
      availableLanguage: ['uk'],
    },
  ],
};
---

<Base title={title} description={description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(organizationLd)} />

  <!-- 1. Герой — «що я тут можу зробити» -->
  <Hero />

  <!-- 2. Скільки платять — «чи варто це того» -->
  <PayBlock />

  <!-- 3. Популярні вакансії — доказ, що дані живі -->
  <section class="section" id="vakansii">
    <div class="shell">
      <div class="section-head">
        <h2 class="section-title">Популярні вакансії</h2>
        <p class="section-note">
          Картки реагують на вибір угорі сторінки. Дані звірено зі штатним розписом{' '}
          <span class="data">{shortDate(lastUpdatedAt())}</span>.
        </p>
      </div>

      <div class="grid" data-vacancy-grid data-limit={CARD_LIMIT}>
        {sorted.map((vacancy, index) => (
          <VacancyCard vacancy={vacancy} hidden={index >= CARD_LIMIT} />
        ))}
      </div>

      <p class="empty" data-empty hidden>
        За таким поєднанням фільтрів зараз немає відкритих позицій.
        <button class="empty__reset" type="button" data-reset>Скинути фільтри</button>
      </p>

      <div class="grid__foot">
        <a class="btn btn--ghost" href="/vacancies" data-catalog-link>
          <span data-catalog-label>Усі {total} {positions(total)}</span>
        </a>
        <button class="btn btn--ghost" type="button" data-reset data-reset-toggle hidden>
          Скинути фільтри
        </button>
      </div>
    </div>
  </section>

  <!-- 4. Три шляхи — сегментація потоків -->
  <PathTiles />

  <!-- 5. Чому через центр — перевірювані зобов'язання -->
  <WhyBlock />
</Base>

<script>
  import '../scripts/filters';
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-4);
  }

  .empty {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--gap-3);
    padding: var(--gap-6) 0;
    color: var(--canvas-dim);
    font-size: 15px;
  }

  .empty__reset {
    background: none;
    border: 0;
    padding: 0;
    color: var(--signal);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: .22em;
  }

  .grid__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-3);
    margin-top: var(--gap-5);
  }

  @media (max-width: 980px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    .grid__foot .btn { width: 100%; }
  }
</style>
