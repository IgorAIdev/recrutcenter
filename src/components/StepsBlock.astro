---
// Нумерація тут виправдана: це справжня послідовність, порядок несе інформацію.
const steps = [
  {
    index: '01',
    title: 'Заявка на сайті',
    duration: '2 хвилини',
    text: 'Обираєте посаду, залишаєте ім’я, телефон і місто. Документи на цьому етапі не потрібні.',
  },
  {
    index: '02',
    title: 'Дзвінок рекрутера',
    duration: 'до 24 годин',
    text: 'Рекрутер уточнює досвід, стан здоров’я та обмеження, відповідає на питання й підтверджує, що позиція вільна.',
  },
  {
    index: '03',
    title: 'Співбесіда з підрозділом',
    duration: '2–5 діб',
    text: 'Розмова з представником підрозділу — офлайн або відео. Тут ви бачите, з ким саме будете служити.',
  },
  {
    index: '04',
    title: 'Оформлення і навчання',
    duration: 'до 45 діб',
    text: 'ТЦК, ВЛК, підписання контракту, базова підготовка. Рекрутер супроводжує на кожному кроці.',
  },
];
---

<section class="section" id="yak-tse-vidbuvayetsia">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">Як це відбувається</h2>
      <p class="section-note">
        Чотири кроки з реальними строками. Якщо строк зривається — це привід
        написати на гарячу лінію, а не чекати.
      </p>
    </div>

    <ol class="steps">
      {steps.map((step) => (
        <li class="step">
          <p class="step__index data">{step.index}</p>
          <p class="step__duration data">{step.duration}</p>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__text dim">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2);
    padding-top: var(--gap-4);
    border-top: 2px solid var(--line-strong);
  }

  .step__index {
    font-size: 12px;
    letter-spacing: .12em;
    color: var(--canvas-dim);
  }

  .step__duration {
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.01em;
  }

  .step__title {
    font-size: 17px;
    font-weight: 500;
    margin-top: var(--gap-2);
  }

  .step__text {
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
