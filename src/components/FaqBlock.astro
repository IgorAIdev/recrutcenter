---
import faq from '../data/faq.json';

// Не загальний FAQ, а конкретні бар'єри, які зупиняють кандидата.
// Розмітка FAQPage — щоб потрапляти в People Also Ask і у відповіді мовних моделей.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="section" id="faq">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">Відповіді на страхи</h2>
      <p class="section-note">
        Питання, які рекрутери чують щодня. Якщо вашого тут немає — телефонуйте
        на гарячу лінію, відповідь з’явиться на цій сторінці.
      </p>
    </div>

    <div class="faq">
      {faq.items.map((item) => (
        <details class="faq__item" name="faq">
          <summary class="faq__question">
            <span>{item.question}</span>
            <span class="faq__marker" aria-hidden="true"></span>
          </summary>
          <p class="faq__answer dim">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .faq {
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-4);
    padding: var(--gap-4) 0;
    font-family: var(--font-display);
    font-size: clamp(17px, 2.2vw, 21px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .01em;
    line-height: 1.15;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker { display: none; }

  .faq__question:hover { color: var(--signal); }

  /* Маркер несе стан: горизонтальна риска = відкрито. */
  .faq__marker {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .faq__marker::before,
  .faq__marker::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform .12s linear;
  }

  .faq__marker::before {
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
  }

  .faq__marker::after {
    top: 0;
    left: 6px;
    width: 2px;
    height: 14px;
  }

  .faq__item[open] .faq__marker::after { transform: scaleY(0); }

  .faq__answer {
    padding-bottom: var(--gap-5);
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.6;
  }
</style>
