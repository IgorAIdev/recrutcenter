---
import FilterChips from './FilterChips.astro';
import { families, countByFamily, regionGroups, vacancyTypes, countBy } from '../data/taxonomy';

/**
 * Спільні контроли фільтрів для героя і каталогу. Один компонент — щоб
 * набір значень не розійшовся між сторінками; синхронізацію робить
 * scripts/filters.ts за атрибутом data-filter.
 */
type Props = {
  /** Підписи над селектами. У каталозі вони зайві — там є заголовок секції. */
  showLabels?: boolean;
};

const { showLabels = true } = Astro.props;

const familyCounts = countByFamily();
const regionCounts = countBy('regionGroup');
const typeCounts = countBy('type');

// У фільтр потрапляють лише родини, в яких справді є позиції.
const familyOptions = families
  .map((family) => ({ ...family, count: familyCounts.get(family.id) ?? 0 }))
  .filter((family) => family.count > 0);

const regionOptions = regionGroups
  .map((region) => ({ value: region.id, label: region.label, count: regionCounts.get(region.id) ?? 0 }))
  .filter((region) => region.count > 0);

const typeOptions = vacancyTypes
  .map((type) => ({ value: type.id, label: type.label, count: typeCounts.get(type.id) ?? 0 }))
  .filter((type) => type.count > 0);
---

<div class="controls">
  <div class="controls__row">
    <label class="field">
      <span class={showLabels ? 'field__label eyebrow' : 'visually-hidden'}>Спеціальність</span>
      <select class="field__control" name="family" data-filter="family">
        <option value="">Будь-яка спеціальність</option>
        {familyOptions.map((family) => (
          <option value={family.id}>{family.label} — {family.count}</option>
        ))}
      </select>
    </label>

    <label class="field">
      <span class={showLabels ? 'field__label eyebrow' : 'visually-hidden'}>Напрямок</span>
      <select class="field__control" name="region" data-filter="region">
        <option value="">Будь-який напрямок</option>
        {regionOptions.map((region) => (
          <option value={region.value}>{region.label} — {region.count}</option>
        ))}
      </select>
    </label>
  </div>

  <FilterChips name="type" legend="Тип посади" options={typeOptions} hideLegend={!showLabels} />
  <!-- Чипи — не поле форми, тому їхнє значення дублюється сюди для GET-переходу. -->
  <input type="hidden" name="type" value="" data-filter-mirror="type" />
</div>

<style>
  .controls {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4);
  }

  .controls__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2);
    min-width: 0;
  }

  .field__control {
    appearance: none;
    width: 100%;
    padding: 12px 40px 12px 14px;
    background: var(--field);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: 16px;
    line-height: 1.2;
    cursor: pointer;
    background-image: linear-gradient(45deg, transparent 50%, var(--canvas-dim) 50%),
      linear-gradient(135deg, var(--canvas-dim) 50%, transparent 50%);
    background-position: right 18px center, right 12px center;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
  }

  .field__control:hover { border-color: var(--canvas-dim); }

  @media (max-width: 620px) {
    .controls__row { grid-template-columns: 1fr; }
  }
</style>
